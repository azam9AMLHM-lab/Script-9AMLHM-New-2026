-- تحديد رتبة ومظهر التاق لكل لاعب
local function getRoleInfo(plr)
    if ScriptOwners[plr.UserId] then
        return "صانع", Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 170, 0) -- ذهبي
    elseif ScriptAdmins[plr.UserId] then
        return "ادمن", Color3.fromRGB(255, 50, 50), Color3.fromRGB(150, 0, 0) -- أحمر
    else
        return "عضو", Color3.fromRGB(0, 180, 255), Color3.fromRGB(0, 100, 200) -- أزرق
    end
end

-- إزالة التاق القديم
local function removeTag(plr)
    if activeTags[plr] then
        activeTags[plr]:Destroy()
        activeTags[plr] = nil
    end
    if plr.Character then
        local oldTag = plr.Character:FindFirstChild("ScriptRankTag")
        if oldTag then oldTag:Destroy() end
    end
end

-- إنشاء التاق فوق رأس اللاعب (متاح للجميع لكي يرى الجميع)
local function createTag(plr)
    -- تم إزالة شرط getgenv().ShowTags الخاص باللاعب المحلي ليتمكن الكل من الرؤية، والتحكم صار عاماً
    if not scriptUsers[plr.UserId] then return end
    if not plr.Character then return end

    local head = plr.Character:FindFirstChild("Head")
    if not head then return end

    removeTag(plr)

    local roleText, col1, col2 = getRoleInfo(plr)

    local gui = Instance.new("BillboardGui")
    gui.Name = "ScriptRankTag"
    gui.Adornee = head
    gui.Parent = plr.Character
    gui.Size = UDim2.new(4, 0, 1.5, 0)
    gui.StudsOffset = Vector3.new(0, 3.5, 0)
    gui.AlwaysOnTop = true

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local gradient = Instance.new("UIGradient", frame)
    gradient.Rotation = 90
    gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, col1),
        ColorSequenceKeypoint.new(1, col2)
    }

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 1.5
    stroke.Color = col1

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = roleText
    label.TextColor3 = Color3.new(1, 1, 1)

    activeTags[plr] = gui
end

-- نظام مراقبة البايو لاكتشاف أي لاعب آخر يشغل السكربت تلقائياً
local function watchPlayerBio(plr)
    -- المطورين والادمنز يتم تحديدهم تلقائياً فوراً بدون الحاجة لقراءة البايو
    if ScriptOwners[plr.UserId] or ScriptAdmins[plr.UserId] then
        scriptUsers[plr.UserId] = true
        if plr.Character then createTag(plr) end
    end

    local bag = plr:WaitForChild("PlayersBag", 10)
    if not bag then return end

    local bio = bag:WaitForChild("RPBio", 10)
    if not bio then return end

    local function checkBio()
        if string.find(tostring(bio.Value), SCRIPT_BIO_TAG) or string.find(tostring(bio.Value), "9AMLHM_USER") or ScriptOwners[plr.UserId] or ScriptAdmins[plr.UserId] then
            scriptUsers[plr.UserId] = true
            createTag(plr)
        end
    end

    checkBio()
    bio.Changed:Connect(checkBio)

    plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        if scriptUsers[plr.UserId] or ScriptOwners[plr.UserId] or ScriptAdmins[plr.UserId] then
            scriptUsers[plr.UserId] = true
            createTag(plr)
        end
    end)
end

